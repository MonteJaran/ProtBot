packaging/version_info.txt
# The bill of materials, generated from requirements.lock by packaging/sbom.py.
# Not committed: it is derived, and a generated file in the tree is a file that
# is stale between the change and the regeneration. CI keeps it as an artifact.
packaging/protbot.cdx.json
*.cdx.json

